# SPA fallback for TanStack Router client-side routes.
# Existing files (assets, /api/*.php, /uploads/*, /data/*.json) are served as-is.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite PHP endpoints or uploads
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]
  RewriteRule ^data/ - [L]

  # Everything else → SPA entry
  RewriteRule ^ index.html [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Increase upload limits (Hetzner Webhosting honours these in most tariffs)
<IfModule mod_php.c>
  php_value upload_max_filesize 2048M
  php_value post_max_size 2100M
  php_value max_execution_time 1800
  php_value max_input_time 1800
  php_value memory_limit 768M
</IfModule>

# Cache policy — prevent stale SPA HTML from referencing deleted chunk hashes.
<IfModule mod_headers.c>
  # Security headers (defense in depth)
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # HTML shell must never be cached — it points to the current asset hashes.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Dynamic JSON data — always fresh.
  <FilesMatch "\.(json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Hashed assets — cache aggressively (filename changes on every build).
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|jpg|jpeg|png|webp|svg|gif|ico|mp3|mp4|mov|webm|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Block access to hidden/dot files and backup files everywhere
<FilesMatch "^\.|\.(bak|old|orig|swp|log)$">
  Require all denied
</FilesMatch>

# Disable server signature
ServerSignature Off
